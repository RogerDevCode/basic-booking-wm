{
  "$schema": "https://raw.githubusercontent.com/google-gemini/gemini-cli/main/schemas/settings.schema.json",
  "mcpServers": {
    "codebase-index": {
      "command": "uv",
      "args": [
        "run",
        "python",
        "-m",
        "mcp_codebase_index.server"
      ],
      "env": {
        "PROJECT_ROOT": "${workspaceFolder}"
      }
    },
    "windmill-booking": {
      "url": "https://titanium.stax.ink/api/mcp/w/booking-titanium/mcp",
      "headers": {
        "Authorization": "Bearer $WINDMILL_MCP_TOKEN"
      }
    },
    "redis": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-redis",
        "redis://localhost:6379"
      ]
    },
    "postgres-local": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://windmill:windmill@localhost:5432/windmill"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "$GITHUB_TOKEN"
      }
    }
  },
  "general": {
    "preferredEditor": "code",
    "vimMode": false,
    "checkpointing": {
      "enabled": true
    }
  },
  "ui": {
    "theme": "default",
    "hideBanner": false,
    "hideTips": false,
    "footer": {
      "hideCWD": false,
      "hideSandboxStatus": false
    }
  },
  "model": {
    "name": "gemini-2.5-pro",
    "maxSessionTurns": -1,
    "chatCompression": {
      "compressionThreshold": 0.3
    }
  },
  "context": {
    "fileName": [
      "AGENTS.md"
    ],
    "fileFiltering": {
      "respectGitIgnore": true,
      "respectGeminiIgnore": true
    }
  },
  "tools": {
    "sandbox": {
      "enabled": false
    },
    "shell": {
      "enableInteractiveShell": true
    },
    "exclude": []
  },
  "privacy": {
    "usageStatisticsEnabled": true
  },
  "telemetry": {
    "enabled": false
  },
  "advanced": {
    "excludedEnvVars": [
      "WINDMILL_MCP_TOKEN",
      "GITHUB_TOKEN"
    ]
  }
}
